---
import { getProductBySlug, getPublishedProducts } from '../../lib/products.js';
import * as pageSettings from '../../lib/pageSettings.js';
import { getServiceOfferBySlug, getServiceOffers } from '../../lib/serviceContent.js';

export function getStaticPaths() {
  return [...getPublishedProducts(), ...getServiceOffers()].map((product) => ({
    params: { slug: product.slug },
  }));
}

const params = Astro.params as unknown as Record<string, string | undefined>;
const slug = String(params.slug || '');
const product = getProductBySlug(slug) || getServiceOfferBySlug(slug);

function getRedirectPath() {
  if (product?.type === 'service') {
    const servicePage = pageSettings.getServiceLandingPageSettingsBySlug(slug);
    if (servicePage?.slug) {
      return `/${servicePage.slug}`;
    }
  }

  return `/${product?.slug || slug}`;
}

if (!product) {
  return Astro.redirect('/#oferta', 302);
}

void getRedirectPath;
return Astro.redirect(getRedirectPath(), 301);
---
