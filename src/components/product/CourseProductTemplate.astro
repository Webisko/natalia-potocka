---
import DigitalProductTemplate from './DigitalProductTemplate.astro';
import { getCourseByProductId } from '../../lib/courses.js';
import { extractRichTextLead } from '../../../shared/richText.js';
import { getProductTemplateContent } from '../../../shared/productTemplateContent.js';

type CourseLesson = {
  title?: string;
  description?: string | null;
  lesson_type?: string | null;
  duration_minutes?: number | null;
  attachments?: Array<{ id?: string; name?: string; url?: string }>;
};

type CourseModule = {
  title?: string;
  description?: string | null;
  lessons?: CourseLesson[];
};

const { product } = Astro.props;
const course = getCourseByProductId(product.id);
const modules: CourseModule[] = Array.isArray(course?.modules) ? course.modules : [];
const totalLessons = modules.reduce((sum: number, module: CourseModule) => sum + (module.lessons?.length || 0), 0);
const totalMaterials = modules.reduce((sum: number, module: CourseModule) => sum + (module.lessons || []).reduce((lessonSum: number, lesson: CourseLesson) => lessonSum + (lesson.attachments?.length || 0), 0), 0);
const totalDuration = modules.reduce((sum: number, module: CourseModule) => sum + (module.lessons || []).reduce((lessonSum: number, lesson: CourseLesson) => lessonSum + (Number(lesson.duration_minutes) || 0), 0), 0);
const templateContent = {
  heroFeaturesTitle: 'W środku znajdziesz',
  bonusMaterialsFallback: 'Materiały dodatkowe i bonusy do pracy własnej',
  lifetimeAccessFallback: 'Dostęp dożywotni z poziomu panelu klientki',
  courseProgramEyebrow: 'Program kursu',
  courseProgramTitle: 'Zawartość kursu',
  courseProgramIntro: 'Tutaj znajdziesz dokładną rozpiskę modułów, lekcji, nagrań i materiałów dodatkowych.',
  courseProgramEmptyState: 'Program kursu jest właśnie uzupełniany.',
  moduleLabel: 'Moduł',
  lessonLabel: 'Lekcja',
  materialsWord: 'materiałów',
  additionalMaterialsWord: 'materiałów dodatkowych',
  ...getProductTemplateContent(product, 'course'),
};
const leadText = product.short_description || product.excerpt || extractRichTextLead(product.long_description) || extractRichTextLead(product.description) || product.description || '';
const durationText = product.duration_label || (totalDuration > 0 ? `Około ${totalDuration} minut materiałów` : null);
---

<DigitalProductTemplate product={product} productLabel="Kurs online" leadTextOverride={leadText} durationTextOverride={durationText}>
  <div slot="hero-details" class="mb-8 mt-7 flex flex-col gap-3 text-[1.18rem] font-light leading-[1.7] text-mauve">
    <div class="text-fs-label font-bold uppercase tracking-[0.2em] text-gold">{templateContent.heroFeaturesTitle}</div>
    <ul class="space-y-3">
      {[
        `${modules.length} ${templateContent.moduleLabel.toLowerCase()}ów z logiczną ścieżką pracy`,
        `${totalLessons} lekcji wideo, audio i tekstowych`,
        totalMaterials > 0 ? `${totalMaterials} ${templateContent.additionalMaterialsWord} do pobrania` : templateContent.bonusMaterialsFallback,
        totalDuration > 0 ? `${totalDuration} minut materiałów` : templateContent.lifetimeAccessFallback,
      ].map((feature) => (
        <li class="flex items-center gap-3 text-base font-light leading-7 text-mauve/72">
          <div class="text-fs-label flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold/10 text-gold">✓</div>
          {feature}
        </li>
      ))}
    </ul>
  </div>

  <Fragment slot="after-details">
    <section class="mx-auto w-full max-w-360 px-8 pb-20 pt-2 md:px-16 md:pb-24">
      <div>
        <div class="mb-6 inline-flex items-center gap-3">
          <span class="h-px w-8 bg-gold/60"></span>
          <span class="text-fs-label font-bold uppercase tracking-[0.2em] text-gold">{templateContent.courseProgramEyebrow}</span>
        </div>
        <h2 class="font-serif text-3xl text-mauve md:text-4xl">{templateContent.courseProgramTitle}</h2>
        <p class="mt-4 max-w-2xl text-lg font-light leading-relaxed text-mauve/78">{templateContent.courseProgramIntro}</p>

        <div class="mt-10 space-y-4">
          {modules.length > 0 ? modules.map((module: CourseModule, moduleIndex: number) => (
            <div class="course-program-item overflow-hidden rounded-[28px] border border-white/80 bg-white/70 shadow-xs" data-course-module data-open={moduleIndex === 0 ? 'true' : 'false'}>
              <button
                type="button"
                class="flex w-full cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left transition-colors hover:bg-white/85 md:px-7 md:py-6"
                data-course-module-toggle
                aria-expanded={moduleIndex === 0 ? 'true' : 'false'}
              >
                <div>
                  <div class="text-fs-label font-bold uppercase tracking-[0.24em] text-gold/90">{templateContent.moduleLabel} {moduleIndex + 1}</div>
                  <h3 class="mt-3 font-serif text-[1.65rem] leading-tight text-mauve md:text-[1.85rem]">{module.title}</h3>
                  {module.description ? <p class="mt-3 max-w-2xl text-[0.98rem] leading-6 text-mauve/50 md:text-base">{module.description}</p> : null}
                </div>
                <div class="flex shrink-0 items-center gap-5">
                  <div class="text-right text-fs-label uppercase tracking-[0.16em] text-mauve/38">
                    <div>{module.lessons?.length || 0} lekcji</div>
                    <div>{(module.lessons || []).reduce((sum: number, lesson: CourseLesson) => sum + (lesson.attachments?.length || 0), 0)} {templateContent.materialsWord}</div>
                  </div>
                  <svg class="course-program-icon h-4 w-4 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
              </button>
              <div class="course-program-content border-t border-mauve/10" data-course-module-content>
                <div class="course-program-inner overflow-hidden px-6 py-3 md:px-7 md:py-4">
                  <div class="divide-y divide-mauve/10">
                    {(module.lessons || []).map((lesson: CourseLesson, lessonIndex: number) => (
                      <div class="py-4 first:pt-2 last:pb-2 md:py-5">
                        <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between md:gap-6">
                          <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-gold/75 md:text-fs-label">
                              <span>{lesson.lesson_type === 'audio' ? 'Audio' : lesson.lesson_type === 'text' ? 'Tekst' : 'Wideo'}</span>
                              <span class="text-mauve/25">•</span>
                              <span>{templateContent.lessonLabel} {lessonIndex + 1}</span>
                            </div>
                            <h4 class="mt-2 text-[1.12rem] font-medium leading-7 text-mauve/88 md:text-[1.2rem]">{lesson.title}</h4>
                            {lesson.description ? <p class="mt-2 max-w-3xl text-[0.98rem] leading-7 text-mauve/60 md:text-base">{lesson.description}</p> : null}
                          </div>
                          <div class="shrink-0 text-[0.74rem] uppercase tracking-[0.18em] text-mauve/36 md:text-right md:text-fs-label">
                            {lesson.duration_minutes ? <div>{lesson.duration_minutes} min</div> : null}
                            <div class="mt-1">{lesson.attachments?.length || 0} {templateContent.additionalMaterialsWord}</div>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )) : (
            <div class="rounded-[28px] border border-dashed border-mauve/15 bg-white/55 px-6 py-8 text-fs-body text-mauve/55">
              {templateContent.courseProgramEmptyState}
            </div>
          )}
        </div>
      </div>
    </section>

    <style is:global>
      .course-program-content {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transition: grid-template-rows 280ms cubic-bezier(0.4, 0, 0.2, 1), opacity 220ms ease;
      }

      .course-program-item[data-open='true'] .course-program-content {
        grid-template-rows: 1fr;
        opacity: 1;
      }

      .course-program-item[data-open='true'] [data-course-module-toggle] {
        background: rgba(255, 255, 255, 0.22);
      }

      .course-program-icon {
        display: block;
        transform: rotate(0deg);
        transform-origin: center;
        transform-box: fill-box;
        transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
      }

      .course-program-item[data-open='true'] .course-program-icon {
        transform: rotate(180deg);
      }
    </style>

    <script is:inline>
      if (!window.__nataliaCourseAccordionInit) {
        window.__nataliaCourseAccordionInit = true;

        const initializeCourseAccordions = () => {
          document.querySelectorAll('[data-course-module]').forEach((item) => {
            if (!(item instanceof HTMLElement) || item.dataset.courseBound === 'true') {
              return;
            }

            const toggle = item.querySelector('[data-course-module-toggle]');
            if (!(toggle instanceof HTMLButtonElement)) {
              return;
            }

            const setExpanded = (expanded) => {
              item.dataset.open = expanded ? 'true' : 'false';
              toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            };

            item.dataset.courseBound = 'true';
            setExpanded(item.dataset.open === 'true');

            toggle.addEventListener('click', () => {
              const expanded = item.dataset.open === 'true';
              const scope = item.parentElement;

              if (!expanded && scope instanceof HTMLElement) {
                scope.querySelectorAll('[data-course-module]').forEach((candidate) => {
                  if (!(candidate instanceof HTMLElement) || candidate === item) {
                    return;
                  }

                  const candidateToggle = candidate.querySelector('[data-course-module-toggle]');
                  if (candidateToggle instanceof HTMLButtonElement) {
                    candidate.dataset.open = 'false';
                    candidateToggle.setAttribute('aria-expanded', 'false');
                  }
                });
              }

              setExpanded(!expanded);
            });
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initializeCourseAccordions, { once: true });
        } else {
          initializeCourseAccordions();
        }

        new MutationObserver(() => initializeCourseAccordions()).observe(document.body, { childList: true, subtree: true });
      }
    </script>
  </Fragment>
</DigitalProductTemplate>
